# ---- Slack (voir slack_manifest.json pour créer l'app) ----
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode (scope connections:write)
SLACK_APP_TOKEN=xapp-...
# ex. C0123456 : canal des alertes techniques (session expirée, erreurs)
SLACK_ALERT_CHANNEL=
# ex. U01AAA,U02BBB ; vide = tous les membres de l'espace
SLACK_ALLOWED_USERS=

# ---- Salesforce : authentification par certificat (JWT, recommandé) ----
# ou https://test.salesforce.com, ou votre My Domain
SALESFORCE_INSTANCE_URL=https://login.salesforce.com
# Consumer Key de l'application connectée
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
# chemin du fichier de clé privée (ex. secrets/salesforce.key), ou contenu PEM avec \n
SALESFORCE_PRIVATE_KEY=
# ---- Salesforce : alternative par mot de passe (laisser vide si JWT) ----
SF_PASSWORD=
SF_SECURITY_TOKEN=
# dépose chaque PDF envoyé sur la fiche Account (ContentVersion)
ARCHIVE_TO_SALESFORCE=true
# tests : Id du compte Salesforce (001...) qui reçoit les PDF à la place du client ; vide = fiche du client
ARCHIVE_TEST_ACCOUNT_ID=

# ---- Portailpro : identifiants par cabinet, référencés depuis cabinets.json ----
PORTAIL_KEOBIZ_LOGIN=
PORTAIL_KEOBIZ_PASSWORD=
# false pour voir le navigateur (mise au point / MFA)
PORTAIL_HEADLESS=true
# chrome | msedge | vide = chromium Playwright
BROWSER_CHANNEL=chrome

# ---- Gmail : soit compte de service (prod), soit OAuth utilisateur (tests) ----
# /secure/gworkspace-sa.json (délégation domain-wide, scope gmail.send)
GOOGLE_SA_KEY_PATH=
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
# si renseigné, TOUS les emails partent à cette adresse (envoi réel)
TEST_RECIPIENT=
# true : aucun email ni archivage, PDF + aperçu déposés dans Slack au demandeur
DRY_RUN=false
# canal Slack où déposer PDF + aperçu en mode test (ex. C0123456) ; vide = canal d'alertes, sinon message direct
DRY_RUN_CHANNEL=

# ---- Journal d'activité MySQL (OVH), facultatif : qui a demandé quoi, quand, avec quel résultat ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# true si la base impose TLS
MYSQL_SSL=false
# nom de la table (créée automatiquement)
MYSQL_TABLE=docs_fiscaux_demandes

# ---- Comptes portail personnels des chargés de mission ----
# Source principale : un Google Sheet des accès, relu régulièrement (nouveau compte, mot de passe changé : pris en compte
# sans redémarrage). Colonnes reconnues par leur intitulé : « Mail de connexion », « Mot de passe », « Chargé de mission »
# (facultatif : « Actif »). Le Sheet doit être partagé en LECTURE avec le compte technique Google ci-dessous.
# Identifiant du Sheet (dans son URL : docs.google.com/spreadsheets/d/<identifiant>/edit) ; vide = comptes du .env seuls
CREDENTIALS_SHEET_ID=
# onglet ; vide = le premier
CREDENTIALS_SHEET_TAB=
# clé JSON du compte technique Google (défaut : GOOGLE_SA_KEY_PATH)
CREDENTIALS_SA_KEY_PATH=
# relecture du Sheet, en secondes
CREDENTIALS_REFRESH_S=900
# navigateurs portail ouverts en même temps (au-delà, le moins récemment utilisé est refermé)
PORTAIL_MAX_SESSIONS=6
# Sans Google Sheet seulement : comptes déclarés dans ce fichier (une série par collaborateur). Avec un Google Sheet,
# ces identifiants ne sont PAS utilisés ; seul ACTIF=false sert encore (désactive le compte même s'il est dans le Sheet).
# Clé du compte technique : à ranger dans secrets/ (jamais à la racine du projet).
# PORTAIL_COLLAB1_LOGIN=
# PORTAIL_COLLAB1_PASSWORD=
# PORTAIL_COLLAB1_EMAIL_SF=
# PORTAIL_COLLAB1_NOM=
# PORTAIL_COLLAB1_ACTIF=true

# ---- Campagnes (traitement en masse) : rien ne démarre sans un clic d'un administrateur dans Slack ----
# IDs Slack (U...) autorisés à créer et lancer des campagnes ; vide = personne
CAMPAIGN_ADMINS=
# clients retenus, en plus du cabinet, d'un SIREN renseigné et d'une mission non annulée (SOQL)
CAMPAIGN_SF_FILTER=StatutMission__c = 'MissionValidee'
# délai en secondes entre deux interrogations du portail (inventaire)
CAMPAIGN_INVENTORY_INTERVAL_S=1.0
# délai en secondes entre deux envois
CAMPAIGN_SEND_INTERVAL_S=5
# envois réels max par jour (quota Gmail ≈ 2000/jour/compte) et heure de reprise le lendemain
CAMPAIGN_DAILY_LIMIT=1000
CAMPAIGN_RESUME_HOUR=7
# canal des messages de suivi et des rapports ; vide = canal d'alertes
CAMPAIGN_CHANNEL=

# ---- Application ----
# base SQLite + PDF + profils Chrome
DATA_DIR=./data
DOC_RETENTION_DAYS=30
# avertir si même client/document/année déjà traité dans cet intervalle
DEDUP_DAYS=30
CABINETS_FILE=cabinets.json
